# Copy to .env and fill in. Never commit .env.

# SQLite for local development. For Postgres use:
#   postgresql://user:password@localhost:5432/podcast
# and update `provider` in prisma/schema.prisma plus the adapter in src/server/db.ts.
DATABASE_URL="file:./prisma/dev.db"

# Public origin, used for canonical URLs, sitemap, RSS and OG tags. Because it is
# NEXT_PUBLIC_*, `next build` inlines it into the client bundle, so a container
# image also has to receive it as a build argument (docker-compose.yml and
# liara.json both pass it under build.args) with exactly this value.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The admin account is (re)created on every server start so you can never be
# locked out. See src/server/bootstrap.ts.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=""

# When true (default), ADMIN_PASSWORD is the source of truth and is re-applied
# on every start. Set to false if you'd rather manage the password in the panel.
ADMIN_SYNC_PASSWORD="true"

# Salt for hashing visitor IPs before they are stored for rate limiting.
# Required in production. Generate with: openssl rand -hex 32
APP_SECRET=""

# Optional. Each new collaboration inquiry is POSTed here as JSON, with `text`
# and `content` fields so Slack and Discord webhooks work out of the box.
INQUIRY_WEBHOOK_URL=""

# Optional. Email me when a collaboration inquiry arrives. Leave SMTP_HOST empty
# to disable. Any SMTP provider works; for Gmail use smtp.gmail.com, port 465,
# and an app password (https://myaccount.google.com/apppasswords).
SMTP_HOST=""
SMTP_PORT="587"
# "true" for implicit TLS (port 465). Defaults to true only when SMTP_PORT is 465.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
# Sender, e.g. "Zavieh <no-reply@example.com>". Defaults to SMTP_USER. Many
# providers reject a From address the account does not own.
MAIL_FROM=""
# Comma-separated recipients. Defaults to ADMIN_EMAIL.
INQUIRY_NOTIFY_EMAIL=""

# Where uploaded audio and images are stored. Use persistent storage (a mounted
# volume) in production; these files are served at runtime, not from public/.
UPLOAD_DIR="storage/uploads"

# Optional. Message me on Bale (works inside Iran) or Telegram for each new
# inquiry. Create a bot with @botfather in the app, send it any message, then
# find your chat id at <API>/bot<TOKEN>/getUpdates ("chat":{"id":...}).
# NOTIFY_BOT_API: https://tapi.bale.ai (Bale, default) or https://api.telegram.org
NOTIFY_BOT_API="https://tapi.bale.ai"
NOTIFY_BOT_TOKEN=""
NOTIFY_BOT_CHAT_ID=""
