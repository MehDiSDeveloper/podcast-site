# Copy to .env and fill in. Never commit .env.

# SQLite for local development. For Postgres use:
#   postgresql://user:password@localhost:5432/podcast
# and update `provider` in prisma/schema.prisma plus the adapter in src/server/db.ts.
DATABASE_URL="file:./prisma/dev.db"

# Public origin, used for canonical URLs, sitemap, RSS and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The admin account is (re)created on every server start so you can never be
# locked out. See src/server/bootstrap.ts.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=""

# When true (default), ADMIN_PASSWORD is the source of truth and is re-applied
# on every start. Set to false if you'd rather manage the password in the panel.
ADMIN_SYNC_PASSWORD="true"
